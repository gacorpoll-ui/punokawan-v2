# Punokawan V2 — Autonomous Trading System Environment
# Copy this file to .env and fill in your settings
# ============================================================

# MCP Server Endpoints
MCP_METATRADER_URL=http://127.0.0.1:8080/sse
MCP_METATRADER_EXT_URL=http://127.0.0.1:8081/sse
MCP_MARKET_ANALYSIS_URL=http://127.0.0.1:8082/sse
MCP_LEARNING_URL=http://127.0.0.1:8083/sse
MCP_RISK_URL=http://127.0.0.1:8084/sse

# MT5 Credentials (fill in your broker details)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Trading Symbol
# Auto-detect: set SYMBOL=XAUUSD and ACCOUNT_TYPE=AUTO
# System checks MT5 account: cent account -> XAUUSDc, USD account -> XAUUSD
# Manual override: SYMBOL=XAUUSDc or SYMBOL=XAUUSD
SYMBOL=XAUUSD
ACCOUNT_TYPE=AUTO

# Data Directories
BASE_DIR=D:\Punokawan V2
CHARTS_DIR=D:\Punokawan V2\charts
LOGS_DIR=D:\Punokawan V2\logs
DATA_DIR=D:\Punokawan V2\data

# Risk Parameters
MAX_RISK_PER_TRADE_PCT=1.5
MAX_DAILY_LOSS=100.0
MAX_SPREAD_PIPS=3.0
MAX_LATENCY_MS=500
MIN_CONFLUENCE_SCORE=6
BLACKOUT_MINUTES=30

# ── Lot Sizing ───────────────────────────────────────────
# Mode: FIXED (exact lot from below) | RISK_PCT (risk % of equity) | KELLY
LOT_MODE=FIXED
FIXED_LOT_SIZE=0.05

# For RISK_PCT mode only:
RISK_PER_TRADE_PCT=1.5

# Learning
SIMILARITY_BLOCK_THRESHOLD=0.80
SIMILARITY_LOT_REDUCTION_THRESHOLD=0.60

# AI Consultation (DeepSeek) — optional, only needed with --ai flag
# Get your key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
