# Punokawan V2 — Autonomous Trading System Environment
# Copy to .env and configure
# ============================================================

# MCP Server Endpoints
MCP_METATRADER_URL=http://127.0.0.1:8080/sse
MCP_METATRADER_EXT_URL=http://127.0.0.1:8081/sse
MCP_MARKET_ANALYSIS_URL=http://127.0.0.1:8082/sse
MCP_LEARNING_URL=http://127.0.0.1:8083/sse
MCP_RISK_URL=http://127.0.0.1:8084/sse

# MT5 Credentials
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# MT5 Terminal Path (leave empty for auto-detect)
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ── Trading Style Preset ─────────────────────────────────
# SCALPING | INTRADAY | SWING | CUSTOM
TRADING_STYLE=SCALPING

# ┌──────────────────┬──────────┬──────────┬──────────┐
# │ Parameter        │ SCALPING │ INTRADAY │ SWING    │
# ├──────────────────┼──────────┼──────────┼──────────┤
# │ Timeframes       │ M1,M5,M15│ M15,H1,H4│ H1,H4,D1 │
# │ Primary TF       │ M1       │ H1       │ H4       │
# │ Min score        │ 4        │ 6        │ 7        │
# │ Risk per trade   │ 0.5%     │ 1.0%     │ 1.5%     │
# │ Daily loss limit │ $30      │ $100     │ $200     │
# │ Min SL (pts)     │ 2.0      │ 5.0      │ 10.0     │
# │ Max SL (pts)     │ 10.0     │ 30.0     │ 60.0     │
# │ Max TP (pts)     │ 20.0     │ 50.0     │ 120.0    │
# │ Min R:R          │ 1.2      │ 1.5      │ 2.0      │
# │ Trailing Stop    │ YES      │ YES      │ YES      │
# │ Trail trigger    │ 3 pts    │ 10 pts   │ 20 pts   │
# │ Max spread (pip) │ 2.0      │ 3.0      │ 5.0      │
# │ Blackout (min)   │ 10       │ 30       │ 60       │
# │ Session filter   │ LON,NY   │ LON,NY   │ ALL      │
# │ Lot mode         │ FIXED    │ RISK_PCT │ RISK_PCT │
# └──────────────────┴──────────┴──────────┴──────────┘

# Trading Symbol
SYMBOL=XAUUSD
ACCOUNT_TYPE=AUTO

# Data Directories
BASE_DIR=D:\Punokawan V2
CHARTS_DIR=D:\Punokawan V2\charts
LOGS_DIR=D:\Punokawan V2\logs
DATA_DIR=D:\Punokawan V2\data

# ── Risk Parameters (override preset if TRADING_STYLE=CUSTOM) ──
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS=50.0
MAX_SPREAD_PIPS=2.0
MAX_LATENCY_MS=300
MIN_CONFLUENCE_SCORE=5
BLACKOUT_MINUTES=15

# ── Lot Sizing ───────────────────────────────────────────
LOT_MODE=FIXED
FIXED_LOT_SIZE=0.05
RISK_PER_TRADE_PCT=1.0

# ── Trade Parameters (used when TRADING_STYLE=CUSTOM) ────
TIMEFRAMES=M1,M5,M15,H1
PRIMARY_TF=M15
MIN_RR_RATIO=1.5
MIN_SL_POINTS=3.0
MAX_SL_POINTS=15.0
MAX_TP_POINTS=30.0
USE_TRAILING_STOP=true
TRAILING_TRIGGER_PTS=5.0
SESSION_FILTER=LONDON,NY

# ── Learning ─────────────────────────────────────────────
SIMILARITY_BLOCK_THRESHOLD=0.80
SIMILARITY_LOT_REDUCTION_THRESHOLD=0.60

# ── AI Consultation ──────────────────────────────────────
AI_PROVIDER=DEEPSEEK
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CUSTOM_API_KEY=
CUSTOM_API_URL=https://your-custom-api.com/v1/chat/completions
CUSTOM_MODEL=gpt-4o
